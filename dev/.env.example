# Copy to dev/.env and change the values: cp dev/.env.example dev/.env
# dev/.env is ignored by git. Never commit real passwords.
POSTGRES_USER=jurwa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jurwa
MONGO_USER=jurwa
MONGO_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Optional: password of the demo accounts in the cluster (dsa.demo@jurwa.example ...).
# Empty: scripts/create-secrets.sh makes a random one. At least 8 characters.
SEED_DEMO_PASSWORD=
# Host port for PostgreSQL. Change it only if 5433 is already in use on your machine.
POSTGRES_HOST_PORT=5433
