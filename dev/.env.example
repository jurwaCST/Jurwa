# Copy to dev/.env and change the values: cp dev/.env.example dev/.env
# dev/.env is ignored by git. Never commit real passwords.
POSTGRES_USER=jurwa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jurwa
MONGO_USER=jurwa
MONGO_PASSWORD=change-me
REDIS_PASSWORD=change-me
# Optional: password of the demo accounts (dsa.cst@rub.edu.bt ...), at least 8
# characters. scripts/create-secrets.sh puts it in the cluster, and
# web/cypress/start-stack.sh uses it locally. Empty: create-secrets makes a random one.
SEED_DEMO_PASSWORD=
# Host port for PostgreSQL. Change it only if 5433 is already in use on your machine.
POSTGRES_HOST_PORT=5433
